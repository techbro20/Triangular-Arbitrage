# Paper-only by default. Live trading is refused until ENABLE_LIVE=true and TRADING_MODE=live.
TRADING_MODE=paper
ENABLE_LIVE=false

# Comma-separated exchange workers (native WS adapters)
# Supported: mexc,kucoin,gateio,htx,bingx,bybit
EXCHANGES=mexc,kucoin,gateio,htx,bingx
START_ASSETS=USDT,USDC
MAX_CYCLE_LENGTH=3
MAX_SYMBOLS=90

# Prefer mid/low liquidity pairs (skip dust + ultra-liquid majors)
PREFER_MID_LOW_LIQUIDITY=true
MIN_QUOTE_VOLUME=20000
MAX_QUOTE_VOLUME=25000000
# Skip stable↔stable and stables+BTC/ETH-only cycles
SKIP_LOW_QUALITY_CYCLES=true

# Net profitability after taker fees + depth walk
MIN_NET_PROFIT_BPS=30
# Per-exchange floors (others use MIN_NET_PROFIT_BPS); MEXC gaps slip badly
MIN_NET_PROFIT_BPS_BY_EXCHANGE=mexc:60
MAX_NOTIONAL=50
MIN_NOTIONAL=5
# Require size >= this fraction of MAX_NOTIONAL (0.5 = $25 when max is $50)
MIN_FILL_NOTIONAL_FRAC=0.5
BOOK_DEPTH=5
BOOK_USAGE_FRAC=0.25
BOOK_STALE_SECONDS=15
COALESCE_MS=25
ALERT_COOLDOWN_SECONDS=60

# Confirm-then-fill: re-score the gap after CONFIRM_MS, then fill legs LEG_LATENCY_MS apart.
# Only fills still >= MIN_NET_PROFIT_BPS are booked; slipped/failed show in /debug + the log.
CONFIRM_MS=250
LEG_LATENCY_MS=250
FADE_COOLDOWN_SECONDS=5
# Liquidity removal: hide taken size this long (never less than the cycle cooldown + 5s);
# block touched pairs this long after a fill
CONSUMED_HOLD_SECONDS=90
PAIR_COOLDOWN_SECONDS=10
# Auto-block a cycle after this many slipped/failed fills in a row, for this many hours
CYCLE_MISS_LIMIT=3
CYCLE_BLOCK_HOURS=4

# Sync checks
MAX_FEED_LAG_MS=3000
MAX_LEG_SKEW_MS=2000
REST_VERIFY_ENABLED=true
REST_VERIFY_BPS=100
REST_DIVERGENCE_BPS=20

# Risk (MAX_CONCURRENT is per exchange)
DAILY_LOSS_LIMIT=10
MAX_CONCURRENT=1

# Optional taker fee overrides: exchange:fee,exchange:fee
# TAKER_FEE_OVERRIDE=mexc:0.001,kucoin:0.001,gateio:0.002
# Per-pair fees (beat everything else), e.g. zero-fee promos:
# TAKER_FEE_PAIR_OVERRIDE=mexc:SUI/USDC=0,kucoin:TEL/USDC=0.001
# Optional READ-ONLY API keys to load your real account fee tier (never trade/withdraw keys):
# EXCHANGE_API_KEYS={"mexc":{"apiKey":"...","secret":"..."},"kucoin":{"apiKey":"...","secret":"...","password":"..."}}

# Paper starting balances (JSON) — fund every START_ASSETS coin per exchange
PAPER_BALANCES={"mexc":{"USDT":1000,"USDC":1000},"kucoin":{"USDT":1000,"USDC":1000},"gateio":{"USDT":1000,"USDC":1000},"htx":{"USDT":1000,"USDC":1000},"bingx":{"USDT":1000,"USDC":1000},"bybit":{"USDT":1000,"USDC":1000}}

# Telegram — used as the paper-trading dashboard (alerts + commands)
TELEGRAM_BOT_TOKEN=
# Your personal chat id (NOT the bot id). Persist here across restarts.
TELEGRAM_CHAT_IDS=

# Logging
OPPORTUNITIES_LOG=logs/opportunities.jsonl
# /pnl all-time is rebuilt from the log on startup. Optionally count only from a local date/time:
# PNL_HISTORY_SINCE=2026-09-27 02:50
LOG_REJECT_PRODUCT_BPS=30
# Same cycle's pre-check reject logged at most once per N seconds
REJECT_LOG_SECONDS=30
